{
  "Function": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:args})",
      "        ${3:return 0}"
    ],
    "description": "Define a function"
  },

  "If statement": {
    "prefix": "if",
    "body": [
      "if ${1:condition}",
      "        ${2:return}"
    ],
    "description": "If block"
  },

  "If-Else": {
    "prefix": "ife",
    "body": [
      "if ${1:condition}",
      "        ${2:return}",
      "else",
      "        ${3:return}"
    ],
    "description": "If-else block"
  },

  "Loop": {
    "prefix": "loop",
    "body": [
      "loop ${1:condition}",
      "        ${2:// body}"
    ],
    "description": "Loop block"
  },

  "Return": {
    "prefix": "ret",
    "body": [
      "return ${1:value}"
    ],
    "description": "Return statement"
  },

  "Assignment": {
    "prefix": "var",
    "body": [
      "${1:name} = ${2:value}"
    ],
    "description": "Variable assignment"
  }
}