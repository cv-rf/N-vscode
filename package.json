{
  "name": "n-vscode",
  "displayName": "N Syntax",
  "publisher": "cvrf",
  "author": {
    "name": "cvrf"
  },
  "description": "Syntax highlighting for the N DSL",
  "version": "0.6.0",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "n",
    "dsl",
    "language",
    "syntax",
    "highlighting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cv-rf/n-vscode"
  },
  "contributes": {
    "languages": [
      {
        "id": "n",
        "extensions": [".n"],
        "aliases": ["N"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "n",
        "scopeName": "source.n",
        "path": "./syntaxes/n.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "n",
        "path": "./snippets/n.json"
      }
    ],
    "configurationDefaults": {
      "[n]": {
        "editor.tabSize": 8,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      }
    }
  }
}